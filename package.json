{
  "name": "sotyware",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "tauri": "tauri",
    "test:frontend": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:headless": "npm run check:rfd-patch && npm run check:release-binary && npm run check:desktop-isolation && npm run check:icons && npm run check:update-key && npm run test:frontend && npm run test:rust",
    "check:rfd-patch": "node scripts/check-rfd-patch.mjs",
    "test:rfd-patch-guard": "node --test scripts/check-rfd-patch.test.mjs",
    "check:release-binary": "node scripts/check-release-binary.mjs --manifest",
    "test:release-binary-guard": "node --test scripts/check-release-binary.test.mjs scripts/build-release.test.mjs",
    "build:release": "node scripts/build-release.mjs",
    "check:desktop-isolation": "node scripts/check-desktop-isolation.mjs",
    "test:desktop-isolation-guard": "node --test scripts/check-desktop-isolation.test.mjs",
    "icons": "node scripts/icons.mjs",
    "check:icons": "node scripts/icons.mjs --check",
    "test:icons": "node --test scripts/icons.test.mjs",
    "test:installer-icons": "node --test scripts/check-installer-icons.test.mjs",
    "build:test-profile": "tauri build --no-bundle --features test-profile -- --target-dir target/test-profile",
    "test:profile-helpers": "python3 -m unittest tests/desktop/test_profile_test.py",
    "test:update-manifest": "node --test scripts/update-manifest.test.mjs",
    "test:release-assemble": "node --test scripts/release-assemble.test.mjs",
    "check:update-key": "node scripts/update-manifest.mjs check-key --allow-missing",
    "test:desktop:virtual": "bash tests/desktop/virtual.sh",
    "test:desktop:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/desktop/windows.ps1",
    "test:desktop:windows:isolated": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/desktop/windows-isolated.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.8",
    "happy-dom": "^21.0.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.7",
    "vitest": "^4.1.12"
  }
}
